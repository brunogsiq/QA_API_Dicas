    {
      "name": "02 - Busca pokemon - todos",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code é 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Json contém 'Nome'\", function () {\r",
              "    pm.expect(pm.response.text()).to.include(\"name\");\r",
              "});\r",
              "\r",
              "// Acessar o objeto JSON da resposta\r",
              "const responseJson = pm.response.json();\r",
              "\r",
              "// Iterar sobre o array de resultados\r",
              "responseJson.results.forEach((pokemon, index) => {\r",
              "    // Extrair o nome\r",
              "    const pokemonName = pokemon.name;\r",
              "\r",
              "    // Extrair o ID do URL (segmento final após a última '/')\r",
              "    const pokemonId = pokemon.url.match(/\\/pokemon\\/(\\d+)\\//)[1];\r",
              "\r",
              "    // Armazenar nome e ID em variáveis de ambiente\r",
              "    pm.environment.set(`pokemonName${index + 1}`, pokemonName);\r",
              "    pm.environment.set(`pokemonId${index + 1}`, pokemonId);\r",
              "});\r",
              "\r",
              "console.log(`Processados ${responseJson.results.length} Pokémons.`);\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/{{pokemonSearch}}?offset=0&limit=150",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{pokemonSearch}}"
          ],
          "query": [
            {
              "key": "offset",
              "value": "0",
              "type": "text"
            },
            {
              "key": "limit",
              "value": "150",
              "type": "text"
            }
          ]
        }
      },
      "response": []
    },
