                      "\r",
                      "// Captura o valor do response body (número retornado)\r",
                      "let responseValue = pm.response.text().trim();\r",
                      "\r",
                      "// Obtém o nome da variável criada no Pre-request Script\r",
                      "let variableName = pm.environment.get(\"current_doc_variable\");\r",
                      "\r",
                      "// Insere o valor do response na nova variável criada\r",
                      "pm.environment.set(variableName, responseValue);\r",
                      "\r",
                      "console.log(`Variável ${variableName} atualizada com o valor: ${responseValue}`);\r",
                      "\r",
                      "console.log();\r",
                      "console.log(\"============FIM de (Gerador_doc)============\");\r",
                      "console.log();\r",
                      ""
                    ],
