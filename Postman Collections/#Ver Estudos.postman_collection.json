              "name": "Gerador_ DOC_dinamico",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "console.log();\r",
                      "console.log(\"============Inicio de (Gerador_doc)============\");\r",
                      "console.log();\r",
                      "\r",
                      "// Função para obter ID aleatório a partir de uma variável de ambiente\r",
                      "function getRandomId(envVariable, outputVariable) {\r",
                      "    let ids = pm.environment.get(envVariable);\r",
                      "    \r",
                      "    if (ids) {\r",
                      "        let idsArray = ids.split(',');\r",
                      "        let randomIndex = Math.floor(Math.random() * idsArray.length);\r",
                      "        let randomId = idsArray[randomIndex].trim();\r",
                      "\r",
                      "        pm.environment.set(outputVariable, randomId);\r",
                      "\r",
                      "        console.log(`IDs disponíveis em ${envVariable}:`, idsArray);\r",
                      "        console.log(`ID escolhido aleatoriamente para ${outputVariable}:`, randomId);\r",
                      "    } else {\r",
                      "        console.log(`A variável '${envVariable}' não está definida ou está vazia.`);\r",
                      "    }\r",
                      "}\r",
                      "// Obter ID randômico \"Filtros_siglasUF_Valores\" para usar em \"UF_Atual\"\r",
                      "getRandomId(\"Filtros_siglasUF_Valores\", \"UF_Atual\");\r",
                      "\r",
                      "\r",
                      "// Função para obter o valor do parâmetro `acao` ativo no form-data\r",
                      "function getActiveAcao() {\r",
                      "    let activeAcao = null;\r",
                      "\r",
                      "    // Verifica se o corpo da requisição existe e é do tipo form-data\r",
                      "    if (pm.request.body && pm.request.body.mode === 'formdata') {\r",
                      "        let formDataItems = pm.request.body.formdata.members;\r",
                      "\r",
                      "        // Itera sobre os itens do form-data\r",
                      "        formDataItems.forEach(function (item) {\r",
                      "            if (item.key === 'acao' && !item.disabled) {\r",
                      "                activeAcao = item.value;\r",
                      "            }\r",
                      "        });\r",
                      "    }\r",
                      "\r",
                      "    if (activeAcao) {\r",
                      "        console.log(`Parâmetro 'acao' ativo: ${activeAcao}`);\r",
                      "        return activeAcao;\r",
                      "    } else {\r",
                      "        throw new Error(\"Nenhum parâmetro 'acao' ativo encontrado!\");\r",
                      "    }\r",
                      "}\r",
                      "\r",
                      "// Obter o valor do parâmetro `acao` ativo\r",
                      "let acao = getActiveAcao();\r",
                      "\r",
                      "// Obtém o contador atual de `acao` ou inicializa em 0\r",
                      "let counter = parseInt(pm.environment.get(`counter_${acao}`), 10) || 0;\r",
                      "\r",
                      "// Se o contador for 0 ou não existir, inicializa com 1\r",
                      "if (counter === 0) {\r",
                      "    counter = 1;\r",
                      "} else {\r",
                      "    // Incrementa o contador para a próxima variável\r",
                      "    counter += 1;\r",
                      "}\r",
                      "\r",
                      "// Gera o nome da nova variável, como \"gerar_cnpj_1\", \"gerar_rg_2\", etc.\r",
                      "let variableName = `${acao}_${counter}`;\r",
                      "\r",
                      "// Armazena o nome da variável que será usada no teste (Post-request)\r",
                      "pm.environment.set(\"current_doc_variable\", variableName);\r",
                      "\r",
                      "// Atualiza o contador no ambiente para a próxima requisição\r",
                      "pm.environment.set(`counter_${acao}`, counter);\r",
                      "\r",
                      "console.log(`Contador atual de ${acao}: ${counter}`);\r",
                      "console.log(`Nova variável criada: ${variableName}`);\r",
                      "\r",
                      "\r",
                      "\r",
                      "\r",
                      "\r",
                      "\r",
                      ""
