                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "console.log();\r",
                      "console.log(\"============Inicio de (Gerador_doc)============\");\r",
                      "console.log();\r",
                      "\r",
                      "// Função para obter ID aleatório a partir de uma variável de ambiente\r",
                      "function getRandomId(envVariable, outputVariable) {\r",
                      "    let ids = pm.environment.get(envVariable);\r",
                      "    \r",
                      "    if (ids) {\r",
                      "        let idsArray = ids.split(',');\r",
                      "        let randomIndex = Math.floor(Math.random() * idsArray.length);\r",
                      "        let randomId = idsArray[randomIndex].trim();\r",
                      "\r",
                      "        pm.environment.set(outputVariable, randomId);\r",
                      "        // pm.collectionVariables.set(outputVariable, randomId);\r",
                      "        // pm.variables.set(outputVariable, randomId);\r",
                      "\r",
                      "        console.log(`IDs disponíveis em ${envVariable}:`, idsArray);\r",
                      "        console.log(`ID escolhido aleatoriamente para ${outputVariable}:`, randomId);\r",
                      "    } else {\r",
                      "        console.log(`A variável '${envVariable}' não está definida ou está vazia.`);\r",
                      "    }\r",
                      "}\r",
                      "\r",
                      "// Obter ID randomico \"NivelRisco_Vlr_Ob\" para usar em NivelRisco\r",
                      "getRandomId(\"Filtros_siglasUF_Valores\", \"UF_Atual\");\r",
                      "\r",
                      "\r",
                      "\r",
                      "//Cria uma nova variável para um novo doc consultado\r",
                      "// Obtém o contador atual de doc ou inicializa em 0\r",
                      "let counter = parseInt(pm.environment.get(\"doc_counter\"), 10) || 0;\r",
                      "\r",
                      "// Se o contador for 0 ou não existir, inicializa com 1\r",
                      "if (counter === 0) {\r",
                      "    counter = 1;\r",
                      "} else {\r",
                      "    // Incrementa o contador para a próxima variável\r",
                      "    counter += 1;\r",
                      "}\r",
                      "\r",
                      "// Gera o nome da nova variável, como \"doc_1\", \"doc_2\", etc.\r",
                      "let variableName = `doc_${counter}`;\r",
                      "\r",
                      "// Armazena o nome da variável que será usada no teste (Post-request)\r",
                      "pm.environment.set(\"current_doc_variable\", variableName);\r",
                      "\r",
                      "// Atualiza o contador no ambiente para a próxima requisição\r",
                      "pm.environment.set(\"doc_counter\", counter);\r",
                      "\r",
                      "console.log(`Contador atual de Doc: ${counter}`);\r",
                      "console.log(`Nova variável criada: ${variableName}`);\r",
                      "\r",
                      ""
                    ],
                    "type": "text/javascript",
                    "packages": {}
                  }
                },
                {
